@model AddOptionViewModel
<form novalidate id="optionForm" method="post" asp-action="AddOption" asp-controller="Exams" asp-area="Teacher" asp-route-classId="@ViewBag.ClassId", asp-route-examId="@ViewBag.ExamId" asp-route-questionId="@Model.QuestionId">
    <div id="optionList"></div>

    <button type="button" class="btn btn-primary mt-3" onclick="addOptionForEditQuestion()">افزودن گزینه</button>
    @if (TempData["Error"]?.ToString() != null)
    {
        <div class="alert alert-danger my-2" role="alert">
            @Html.Raw(TempData["Error"]?.ToString())
        </div>
    }
</form>