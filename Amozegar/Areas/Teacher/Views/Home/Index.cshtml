@model DashboardViewModel
@{
    ViewData["Title"] = "کلاس";

}

<h1>داشبورد</h1>
<div class="container py-5">
    <div class="row g-4">


        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل دانش آموزان</div>
                <div class="card-body">
                    <p class="card-text">@Model.StudentsCount</p>
                </div>
            </div>
        </div>


        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل درخواست های ورود</div>
                <div class="card-body">
                    <p class="card-text">@Model.LoginsToClassCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-primary mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل دانش آموزان مسدود شده</div>
                <div class="card-body">
                    <p class="card-text">@Model.BanndedStudentsCount</p>
                </div>
            </div>
        </div>



        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-secondary mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل اعلان ها</div>
                <div class="card-body">
                    <p class="card-text">@Model.NotificationsCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-success mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل تکالیف</div>
                <div class="card-body">
                    <p class="card-text">@Model.HomeworksCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-success mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد تکالیف بسته شده</div>
                <div class="card-body">
                    <p class="card-text">@Model.ClosedHomeworksCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-success mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد تکالیف باز</div>
                <div class="card-body">
                    <p class="card-text">@Model.OpenHomeworksCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-danger mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل تکالیف ارسال شده</div>
                <div class="card-body">
                    <p class="card-text">@Model.HomeworkSentsCount</p>
                </div>
            </div>
        </div>


        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-info mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد کل امتحانات</div>
                <div class="card-body">
                    <p class="card-text">@Model.ExamsCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-info mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد امتحانات در حال برگزاری</div>
                <div class="card-body">
                    <p class="card-text">@Model.OngoingExamsCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-info mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد امتحانات در حال ساخت</div>
                <div class="card-body">
                    <p class="card-text">@Model.DraftExamsCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-info mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد امتحانات تکمیل شده</div>
                <div class="card-body">
                    <p class="card-text">@Model.CompletedExamsCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-info mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد امتحانات برنامه ریزی شده</div>
                <div class="card-body">
                    <p class="card-text">@Model.ScheduledExamsCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card text-bg-info mb-3" style="max-width: 18rem;">
                <div class="card-header">تعداد امتحانات بسته شده</div>
                <div class="card-body">
                    <p class="card-text">@Model.ClosedExamsCount</p>
                </div>
            </div>
        </div>

    </div>
</div>