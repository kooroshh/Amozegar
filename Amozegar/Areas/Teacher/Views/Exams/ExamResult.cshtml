@model ExamRsultsViewModel
@{
    ViewData["Title"] = "جزعیات امتحان";
}

<!-- Exam Information Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="card-title mb-0">اطلاعات امتحان</h3>
            <a asp-action="Index" asp-controller="Exams" asp-area="Shared" asp-route-roleName="Teacher" asp-route-classId="@ViewBag.ClassId" asp-route-pageNumber="1"
                class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-2"></i>
                بازگشت به لیست امتحانات
            </a>
        </div>

        <div class="exam-info-grid">
            <div class="row">
                <div class="col-lg-8">
                    <div class="exam-basic-info">
                        <h2 class="exam-title mb-3">@Model.ExamTitle</h2>
                        <p class="exam-description mb-4">@Model.ExamDescription</p>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-item mb-3">
                                    <i class="fas fa-calendar-plus text-primary me-2"></i>
                                    <span class="label">تاریخ ایجاد:</span>
                                    <span class="value">@Model.CreatedAt</span>
                                </div>
                                <div class="info-item mb-3">
                                    <i class="fas fa-play-circle text-success me-2"></i>
                                    <span class="label">تاریخ شروع:</span>
                                    <span class="value">@Model.StartDate</span>
                                </div>
                                <div class="info-item mb-3">
                                    <i class="fas fa-stop-circle text-danger me-2"></i>
                                    <span class="label">تاریخ پایان:</span>
                                    <span class="value">@Model.EndDate</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item mb-3">
                                    <i class="fas fa-info-circle text-info me-2"></i>
                                    <span class="label">وضعیت امتحان:</span>
                                    <span class="badge bg-success ms-2">@Model.State</span>
                                </div>
                                <div class="info-item mb-3">
                                    <i class="fas fa-question-circle text-warning me-2"></i>
                                    <span class="label">تعداد سوالات:</span>
                                    <span class="value">@Model.QuestionCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="exam-stats-card">
                        <h4 class="mb-3">آمار کلی</h4>
                        <div class="stat-item">
                            <div class="stat-number">@Model.Joiner</div>
                            <div class="stat-label">شرکت کننده</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">@Model.ScoreAvarage٪</div>
                            <div class="stat-label">میانگین نمرات</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">@Model.Accepted</div>
                            <div class="stat-label">قبول شده</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Student Results Section -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        @if (Model.StudentsResults.Count() <= 0)
        {
            <div class="alert alert-warning">
                توجه هیچ امتحانی وجود ندارد.
            </div>
        }
        else
        {
            <div class="alert alert-light">
                تعداد کل امتحانات : @ViewBag.Count
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">

                <h3 class="card-title mb-0">نتایج دانش‌آموزان</h3>

                <div class="d-flex gap-2">

                    <div>
                        @if (ViewBag.HasPrev)
                        {
                            <a asp-action="ExamResult"
                               asp-controller="Exams"
                               asp-area="Teacher"
                               asp-route-classId="@ViewBag.ClassId"
                               asp-route-examId="@Model.ExamId"
                               asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                               class="btn btn-primary ">صفحه ی قبل</a>
                        }
                        else
                        {
                            <a class="btn btn-primary disabled">صفحه ی قبل</a>
                        }
                    </div>
                    <div>
                        @if (ViewBag.HasNext)
                        {
                            <a asp-action="ExamResult"
                               asp-controller="Exams"
                               asp-area="Teacher"
                               asp-route-classId="@ViewBag.ClassId"
                               asp-route-examId="@Model.ExamId"
                               asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                               class="btn btn-primary ">صفحه ی بعد</a>
                        }
                        else
                        {
                            <a class="btn btn-primary disabled">صفحه ی بعد</a>
                        }
                    </div>

                </div>



            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 60px">تصویر</th>
                            <th scope="col">نام دانش‌آموز</th>
                            <th scope="col" style="width: 120px">وضعیت</th>
                            <th scope="col" style="width: 100px">جواب درست</th>
                            <th scope="col" style="width: 80px">نمره</th>
                            <th scope="col" style="width: 120px">تاریخ شرکت</th>
                            <th scope="col" style="width: 120px">کل جواب‌ها</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var user in Model.StudentsResults)
                        {
                            <tr>
                                <td>
                                    <img src="~/images/users/@(user.StudentImage)"
                                         alt="دانش‌آموز"
                                         class="rounded-circle"
                                         width="45"
                                         height="45"
                                         style="object-fit: cover;">
                                </td>
                                <td>
                                    <div class="student-name">@user.StudentName</div>
                                </td>
                                <td>
                                    <span class="badge bg-success">@user.StudentStatus</span>
                                </td>
                                <td>
                                    <span class="correct-answers">@user.TrueAwnserCount</span>
                                </td>
                                <td>
                                    <span class="score-percentage">@user.Score٪</span>
                                </td>
                                <td>
                                    <span class="participation-date">@user.JoinAt</span>
                                </td>
                                <td>
                                    <div class="answer-summary">
                                        <span class="correct">@user.TrueAwnserCount</span> /
                                        <span class="incorrect">@user.FalseAwnserCount</span>
                                    </div>
                                </td>
                            </tr>

                        }

                    </tbody>
                </table>
            </div>
        }


    </div>
</div>