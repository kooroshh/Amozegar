@model QuestionForDoViewModel
@{
    ViewData["Title"] = "انجام امتحان";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-light p-4">
    <div class="container">
        <h2 class="mb-4 text-center">سوال امتحانی || سوال @Model.CurrentQuestionIndex از @Model.QuestionsCount سوال</h2>

        <form method="POST">
            <!-- سوال ۱ -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@Model.QuestionAsk</h5>

                    <div class="alert alert-secondary">تعداد کل گزینه ها : @Model.OptionsCount</div>
                    <span asp-validation-for="@Model.AwnserOptionId" class="text-danger small"></span>
                    <!-- گزینه‌ها -->
                    @foreach(var option in Model.Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="AwnserOptionId" id="opt@(option.QuestionOptionId)" value="@option.QuestionOptionId" @(option.IsAwnser ? "checked" : "")>
                            <label class="form-check-label" for="opt@(option.QuestionOptionId)">@option.Option</label>
                        </div>
                    }

                    <div class="d-flex gap-3">

                        <div>
                            @if (ViewBag.HasPrev)
                            {
                                <a asp-action="DoExam"
                                   asp-controller="Exams"
                                   asp-area="Student"
                                   asp-route-classId="@ViewBag.ClassId"
                                   asp-route-examId="@ViewBag.ExamId"
                                   asp-route-questionIndex="@Model.CurrentQuestionIndex"
                                   asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                                   class="btn btn-primary ">گزینه های قبلی</a>
                            }
                            else
                            {
                                <a class="btn btn-primary disabled">گزینه های قبلی</a>
                            }
                        </div>
                        <div>
                            @if (ViewBag.HasNext)
                            {
                                <a asp-action="DoExam"
                                   asp-controller="Exams"
                                   asp-area="Student"
                                   asp-route-classId="@ViewBag.ClassId"
                                   asp-route-examId="@ViewBag.ExamId"
                                   asp-route-questionIndex="@Model.CurrentQuestionIndex"
                                   asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                                   class="btn btn-primary ">گزینه های بعدی</a>
                            }
                            else
                            {
                                <a class="btn btn-primary disabled">گزینه های بعدی</a>
                            }
                        </div>
                    </div>

                </div>
            </div>
            <div class="d-flex flex-row-reverse justify-content-end gap-3">
                @if (ViewBag.IsLast)
                {
                    <button type="submit" class="btn btn-primary">ثبت و پایان امتحان</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">سوال بعدی</button>
                }

                @if (Model.CurrentQuestionIndex == 1)
                {
                    <a class="btn btn-primary disabled">سوال قبلی</a>
                }
                else
                {
                    <a asp-action="DoExam"
                        asp-controller="Exams"
                        asp-area="Student"
                       asp-route-classId="@ViewBag.ClassId"
                       asp-route-examId="@ViewBag.ExamId"
                       asp-route-questionIndex="@(Model.CurrentQuestionIndex - 1)"
                       asp-route-pageNumber="1"
                       class="btn btn-primary">
                        سوال قبلی
                    </a>
                }
            </div>

        </form>
    </div>
</div>
