@model IEnumerable<ExamsViewModel>
@{
    ViewData["Title"] = "امتحانات";

    string getBadgeClassForState(string state)
    {
        return state switch
        {
            "Ongoing" => "bg-success",
            "Draft" => "bg-danger",
            "Completed" => "bg-primary",
            "Scheduled" => "bg-info",
            "Closed" => "bg-warning",
        };
    }
}
<!-- Exams Section -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="card-title mb-0">امتحانات</h3>

            <div class="d-flex gap-2">

                @if (ViewBag.IsTeacher)
                {
                    <div>
                        <a asp-action="AddExams"
                           asp-controller="Exams"
                           asp-area="Teacher"
                           asp-route-classId="@ViewBag.classId"
                           class="btn btn-primary">افزودن</a>
                    </div>
                }

                <div>
                    @if (ViewBag.HasPrev)
                    {
                        <a asp-action="Index"
                           asp-controller="Homeworks"
                           asp-area="Shared"
                           asp-route-classId="@ViewBag.ClassId"
                           asp-route-roleName="@ViewBag.roleName"
                           asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                           class="btn btn-primary ">صفحه ی قبل</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی قبل</a>
                    }
                </div>
                <div>
                    @if (ViewBag.HasNext)
                    {
                        <a asp-action="Index"
                           asp-controller="Homeworks"
                           asp-area="Shared"
                           asp-route-classId="@ViewBag.ClassId"
                           asp-route-roleName="@ViewBag.roleName"
                           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                           class="btn btn-primary ">صفحه ی بعد</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی بعد</a>
                    }
                </div>

            </div>



        </div>

        <!-- Exams List -->
        <div class="exams-list">

            @if (Model.Count() <= 0)
            {
                <div class="alert alert-warning">
                    توجه هیچ امتحانی وجود ندارد.
                </div>
            }
            else
            {
                <div class="alert alert-light">
                    تعداد کل امتحانات : @ViewBag.Count
                </div>
                <div asp-validation-summary="All" class="text-danger"></div>
                @foreach (var exam in Model)
                {
                    <div class="exam-item">
                        <div class="exam-header">
                            <h4 class="exam-subject">@exam.ExamTitle</h4>
                            <div class="exam-status">

                                <span class="badge @getBadgeClassForState(exam.State)">
                                    @exam.PersianState
                                </span>


                            </div>
                        </div>
                        <div class="exam-details">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="exam-info-item">
                                        <i class="fas fa-calendar-plus text-primary me-2"></i>
                                        <span class="label">تاریخ ساخت:</span>
                                        <span class="value">@exam.CreatedAt</span>
                                    </div>
                                    <div class="exam-info-item">
                                        <i class="fas fa-play-circle text-success me-2"></i>
                                        <span class="label">تاریخ شروع:</span>
                                        <span class="value">@exam.StartAt</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="exam-info-item">
                                        <i class="fas fa-stop-circle text-danger me-2"></i>
                                        <span class="label">تاریخ پایان:</span>
                                        <span class="value">@exam.EndAt</span>
                                    </div>
                                    <div class="exam-info-item">
                                        <i class="fas fa-question-circle text-info me-2"></i>
                                        <span class="label">تعداد سوالات:</span>
                                        <span class="value">@exam.QuestionsCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="exam-actions">

                            @if(ViewBag.IsTeacher)
                            {
                                @if (exam.State == "Completed")
                                {
                                    <a asp-action="ExamResult"
                                       asp-controller="Exams"
                                       asp-route-classId="@ViewBag.ClassId"
                                       asp-route-examId="@exam.ExamId"
                                       asp-area="Teacher"
                                       asp-route-pageNumber="1"
                                       class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-eye me-1"></i>
                                        مشاهده نتایج
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="EditExam"
                                       asp-controller="Exams"
                                       asp-route-classId="@ViewBag.ClassId"
                                       asp-route-examId="@exam.ExamId"
                                       asp-route-pageNumber="1"
                                       asp-area="Teacher"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit me-1"></i>
                                        ویرایش
                                    </a>


                                    <a href="javascript:void(0)"
                                       onclick="openConfirmModal('@Url.Action("DeleteExam", "Exams", new { classId = ViewBag.ClassId, examId = exam.ExamId, area = "Teacher" })', 'آیا از حذف امتحان اطمینان دارید؟')"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="fa-solid fa-lock me-1"></i>
                                        حذف
                                    </a>
                                    <a href="javascript:void(0)"
                                       onclick="openConfirmModal('@Url.Action("CloseExam", "Exams", new { classId = ViewBag.ClassId, examId = exam.ExamId, area = "Teacher" })', 'آیا از حذف امتحان اطمینان دارید؟')"
                                       class="btn btn-outline-warning btn-sm">
                                        <i class="fa-solid fa-xmark me-1"></i>
                                        بستن امتحان
                                    </a>
                                }
                            }
                            else
                            {
                                <a asp-action="DisplayExam"
								   asp-controller="Exams"
								   asp-route-classId="@ViewBag.ClassId"
								   asp-route-examId="@exam.ExamId"
								   asp-area="Student"
                                   asp-route-type="@exam.State"
                                   class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-eye me-1"></i>
									مشاهده جزعیات
								</a>
                            }


                        </div>
                    </div>
                }

            }

        </div>

    </div>
</div>
