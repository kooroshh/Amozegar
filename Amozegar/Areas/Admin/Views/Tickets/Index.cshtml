@model IEnumerable<TicketViewModel>
@{
    ViewData["Title"] = "تیکت ها";
}

<!-- Tickets Management Section -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="card-title mb-0">مدیریت تیکت ها</h3>

            <div class="d-flex gap-2">
                <div>
                    @if (ViewBag.HasPrev)
                    {
                        <a asp-action="Index"
                           asp-controller="Tickets"
                           asp-area="Admin"
                           asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                           class="btn btn-primary ">صفحه ی قبل</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی قبل</a>
                    }
                </div>
                <div>
                    @if (ViewBag.HasNext)
                    {
                        <a asp-action="Index"
                           asp-controller="Tickets"
                           asp-area="Admin"
                           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                           class="btn btn-primary ">صفحه ی بعد</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی بعد</a>
                    }
                </div>
            </div>


        </div>

        <!-- Search and Filter Bar -->
        <div class="mb-4 admin-search-filters">
            <div class="alert alert-light">
                تعداد کل تیکت ها : @ViewBag.Count
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@Html.Raw(TempData["Error"]?.ToString())</div>
            }
        </div>


        @if(Model.Count() <= 0)
        {
            <div class="alert alert-warning">هیچ تیکتی وجود ندارد</div>
        }
        else
        {
            <!-- Tickets Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">عنوان تیکت</th>
                            <th scope="col" style="width: 150px">نام کاربر</th>
                            <th scope="col" style="width: 200px" class="d-lg-table-cell">ایمیل</th>
                            <th scope="col" style="width: 130px" class="d-lg-table-cell">شماره تماس</th>
                            <th scope="col" style="width: 140px" class="d-lg-table-cell">زمان ساخت</th>
                            <th scope="col" style="width: 120px">عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="ticketsTableBody">


                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td data-label="عنوان">
                                    <div class="ticket-title">
                                        <strong>@ticket.TicketSubject</strong>
                                    </div>
                                </td>
                                <td data-label="نام کاربر">
                                    <div class="user-info">
                                        <div class="user-name">@ticket.UserFullName</div>
                                    </div>
                                </td>
                                <td data-label="ایمیل" class="d-lg-table-cell">@ticket.UserEmail</td>
                                <td data-label="شماره تماس" class="d-lg-table-cell">@ticket.UserPhoneNumber</td>
                                <td data-label="زمان ساخت" class="d-lg-table-cell">
                                    <small class="text-muted">@ticket.CreatedAt</small>
                                </td>
                                <td data-label="عملیات">
                                    <div class="btn-group" role="group">
                                        <a asp-action="ShowTicket" asp-controller="Tickets" asp-area="Admin" asp-route-ticketId="@ticket.TicketId" class="btn btn-outline-info btn-sm" title="مشاهده جزئیات">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="javascript:void(0)" title="حذف تیکت"
                                           onclick="openConfirmModal('@Url.Action("DeleteTicket", "Tickets", new { ticketId = ticket.TicketId, area = "Admin" })', 'آیا از حذف کردن تیکت اطمینان دارید؟')"
                                           class="btn btn-outline-danger btn-sm delete-ticket-btn">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                        }

                    </tbody>
                </table>
            </div>
        }

    </div>
</div>