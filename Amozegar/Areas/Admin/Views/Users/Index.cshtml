@using Newtonsoft.Json
@model IEnumerable<UsersViewModel>
@{
    ViewData["Title"] = "کاربران";
}
@await Component.InvokeAsync("ChangeRoles")

<!-- Users Management Section -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="card-title mb-0">مدیریت کاربران</h3>


            <div class="d-flex gap-2">
                <div>
                    @if (ViewBag.HasPrev)
                    {
                        <a asp-action="Index"
                           asp-controller="Users"
                           asp-area="Admin"
                           asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                           class="btn btn-primary ">صفحه ی قبل</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی قبل</a>
                    }
                </div>
                <div>
                    @if (ViewBag.HasNext)
                    {
                        <a asp-action="Index"
                           asp-controller="Users"
                           asp-area="Admin"
                           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                           class="btn btn-primary ">صفحه ی بعد</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی بعد</a>
                    }
                </div>
            </div>

        </div>




        <!-- Search and Filter Bar -->
        <div class="mb-4 admin-search-filters px-3">

            <div class="alert alert-light">
                تعداد کل کاربران : @ViewBag.Count
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@Html.Raw(TempData["Error"]?.ToString())</div>
            }

        </div>

        <!-- Users Table -->
        <div class="table-responsive px-3">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px">تصویر</th>
                        <th scope="col">نام کاربر</th>
                        <th scope="col">ایمیل</th>
                        <th scope="col" style="width: 120px" class="d-lg-table-cell">نقش</th>
                        <th scope="col" style="width: 120px">وضعیت</th>
                        <th scope="col" style="width: 140px" class="d-lg-table-cell">تاریخ عضویت</th>
                        <th scope="col" style="width: 200px">عملیات</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>
                            <td data-label="تصویر">
                                <img src="~/images/users/@(user.Image)"
                                     alt="تصویر کاربر"
                                     class="rounded-circle"
                                     width="50"
                                     height="50"
                                     style="object-fit: cover;">
                            </td>
                            <td data-label="نام کاربر">
                                <div class="user-info">
                                    <div class="user-name">@user.UserName</div>
                                </div>
                            </td>
                            <td data-label="ایمیل">@user.Email</td>
                            <td data-label="نقش" class="d-lg-table-cell">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-warning">@role</span>
                                }
                            </td>
                            <td data-label="وضعیت">
                                <span class="badge bg-@(user.IsBan ? "danger" : "success")">@user.Status</span>
                            </td>
                            <td data-label="تاریخ عضویت" class="d-lg-table-cell">
                                <small class="text-muted">@user.CreatedAt</small>
                            </td>
                            <td data-label="عملیات">
                                <div class="btn-group" role="group">
                                    <button class="btn btn-outline-success btn-sm delete-user-btn" title="ویرایش نقش ها" type="button"
                                            onclick='openEditRolesModal("@user.UserId", @Html.Raw(JsonConvert.SerializeObject(user.Roles)) )'>
                                        <i class="fa-solid fa-user-pen"></i>
                                    </button>
                                    @if (!user.IsBan)
                                    {
                                        <a href="javascript:void(0)" title="مسدود کردن"
                                           onclick="openConfirmModal('@Url.Action("BanUser", "Users", new { userId = user.UserId, area = "Admin" })', 'آیا از مسدود کردن کاربر اطمینان دارید؟')"
                                           class="btn btn-outline-warning btn-sm ban-user-btn">
                                            <i class="fas fa-ban"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="javascript:void(0)" title="رفع مسدودیت"
                                           onclick="openConfirmModal('@Url.Action("UnBan", "Users", new { userId = user.UserId, area = "Admin" })', 'آیا از رفع مسدودیت کاربر اطمینان دارید؟')"
                                           class="btn btn-outline-primary btn-sm ban-user-btn">
                                            <i class="fa-solid fa-unlock"></i>
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }


                </tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function openEditRolesModal(userId, userRoles) {

            const form = document.getElementById("editUserRolesForm");
            form.action = `/Panel/Users/UpdateUserRoles/${userId}`;


            document.querySelectorAll("#roleCheckboxContainer input[type='checkbox']").forEach(cb => {
                cb.checked = false;
            });


            document.querySelectorAll("#roleCheckboxContainer input[type='checkbox']").forEach(cb => {
                const roleName = cb.dataset.roleName;
                if (userRoles.includes(roleName)) {
                    cb.checked = true;
                }
            });

            const modal = new bootstrap.Modal(document.getElementById('editUserRolesModal'));
            modal.show();
        }
    </script>

}
