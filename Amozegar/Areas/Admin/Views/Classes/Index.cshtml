@model IEnumerable<ClassViewModel>
@{
    ViewData["Title"] = "کلاس ها";
}

<!-- Classes Management Section -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="card-title mb-0">مدیریت تیکت ها</h3>

            <div class="d-flex gap-2">
                <div>
                    @if (ViewBag.HasPrev)
                    {
                        <a asp-action="Index"
                           asp-controller="Classes"
                           asp-area="Admin"
                           asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                           class="btn btn-primary ">صفحه ی قبل</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی قبل</a>
                    }
                </div>
                <div>
                    @if (ViewBag.HasNext)
                    {
                        <a asp-action="Index"
                           asp-controller="Classes"
                           asp-area="Admin"
                           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                           class="btn btn-primary ">صفحه ی بعد</a>
                    }
                    else
                    {
                        <a class="btn btn-primary disabled">صفحه ی بعد</a>
                    }
                </div>
            </div>


        </div>

        <!-- Search and Filter Bar -->
        <div class="row mb-4 admin-search-filters">
            <div class="alert alert-light">
                تعداد کل تیکت ها : @ViewBag.Count
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@Html.Raw(TempData["Error"]?.ToString())</div>
            }
        </div>

        @if (Model.Count() <= 0)
        {
            <div class="alert alert-warning">هیچ تیکتی وجود ندارد</div>
        }
        else
        {
            <!-- Classes Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px">تصویر</th>
                            <th scope="col">نام کلاس</th>
                            <th scope="col" style="width: 100px">آیدی کلاس</th>
                            <th scope="col" style="width: 150px">نام معلم</th>
                            <th scope="col" style="width: 120px" class="d-lg-table-cell">تاریخ ساخت</th>
                            <th scope="col" style="width: 120px">وضعیت</th>
                            <th scope="col" style="width: 80px" class="d-lg-table-cell">اعلانات</th>
                            <th scope="col" style="width: 80px" class="d-lg-table-cell">تکالیف</th>
                            <th scope="col" style="width: 80px" class="d-lg-table-cell">امتحانات</th>
                            <th scope="col" style="width: 100px" class="d-lg-table-cell">دانش‌آموزان فعال</th>
                            <th scope="col" style="width: 200px">عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="classesTableBody">

                        @foreach (var c in Model)
                        {
                            <tr>
                                <td data-label="تصویر">
                                    <img src="~/images/classes/@(c.ClassImage)"
                                         alt="تصویر کلاس"
                                         class="rounded"
                                         width="60"
                                         height="45"
                                         style="object-fit: cover;">
                                </td>
                                <td data-label="نام کلاس">
                                    <div class="class-info">
                                        <div class="class-name">@c.ClassName</div>
                                    </div>
                                </td>
                                <td data-label="آیدی کلاس">
                                    <code class="bg-light px-2 py-1 rounded">#@c.ClassIdentity</code>
                                </td>
                                <td data-label="نام معلم">@c.TeacherName</td>
                                <td data-label="تاریخ ساخت" class="d-lg-table-cell">
                                    <small class="text-muted">@c.CreatedAt</small>
                                </td>
                                <td data-label="وضعیت">
                                    <span class="badge bg-secondary">@c.PersianState</span>
                                </td>
                                <td data-label="اعلانات" class="d-lg-table-cell">
                                    <span class="badge bg-info">@c.NotificationsCount</span>
                                </td>
                                <td data-label="تکالیف" class="d-lg-table-cell">
                                    <span class="badge bg-warning">@c.HomeworksCount</span>
                                </td>
                                <td data-label="امتحانات" class="d-lg-table-cell">
                                    <span class="badge bg-primary">@c.ExamsCount</span>
                                </td>
                                <td data-label="دانش‌آموزان" class="d-lg-table-cell">
                                    <span class="badge bg-secondary">@c.StudentsCount</span>
                                </td>
                                <td data-label="عملیات">
                                    <div class="btn-group" role="group">
                                        <a asp-action="ShowClass" asp-controller="Classes" asp-area="Admin" asp-route-pageNumber="1" asp-route-classId="@c.ClassId" class="btn btn-outline-info btn-sm" title="مشاهده جزئیات">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (c.State == "Active")
                                        {
                                            <a href="javascript:void(0)"
                                               onclick="openConfirmModal('@Url.Action("BanClass", "Classes", new { classId = c.ClassId, area = "Admin" })', 'آیا از بن کردن کلاس اطمینان دارید؟')"
                                               class="btn btn-outline-warning btn-sm ban-class-btn" title="مسدود کردن">
                                                <i class="fas fa-ban"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0)" title="رفع مسدودیت"
                                               onclick="openConfirmModal('@Url.Action("UnBanClass", "Classes", new { classId = c.ClassId, area = "Admin" })', 'آیا از رفع مسدودیت کلاس اطمینان دارید؟')"
                                               class="btn btn-outline-primary btn-sm ban-user-btn">
                                                <i class="fa-solid fa-unlock"></i>
                                            </a>
                                        }
                                        <a href="javascript:void(0)"
                                           onclick="openConfirmModal('@Url.Action("DeleteClass", "Classes", new { classId = c.ClassId, area = "Admin" })', 'آیا از حذف کردن کلاس اطمینان دارید؟')"
                                           class="btn btn-outline-danger btn-sm delete-class-btn" title="حذف کلاس">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        }



    </div>
</div>

